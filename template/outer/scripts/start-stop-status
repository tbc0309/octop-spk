#!/bin/sh
# 启停由群晖资源工作器处理；状态仅通过群晖只读工具查询。
case "$1" in
    start|stop) exit 0 ;;
    status)
        # 工具查询失败与容器已停止分别返回未知、未运行。
        INSPECT=/var/packages/ContainerManager/target/tool/docker_inspect
        [ -x "$INSPECT" ] || exit 4
        STATE=$("$INSPECT" synology-octop 2>/dev/null) || exit 4
        printf '%s\n' "$STATE" | grep -q '"Status"[[:space:]]*:[[:space:]]*"running"' && exit 0
        printf '%s\n' "$STATE" | grep -q '"Status"[[:space:]]*:' || exit 4
        exit 3
        ;;
    log) echo "请在 Container Manager 中查看 synology-octop 容器日志。" ;;
    *) exit 1 ;;
esac
